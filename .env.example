# Twin Receptionist settings. Locally these live in ~/aibiz/.env; in the cloud,
# set them in the host's environment.

# --- Required ---
DATABASE_URL=postgres://twin:password@127.0.0.1:55433/twin   # Supabase or RDS in the cloud (add ?sslmode=require or verify-full)
TELNYX_API_KEY=
# Voice engine for new receptionists: telnyx (default) or vapi. An agency can choose its own in Connections.
VOICE_PROVIDER=
# Vapi (when VOICE_PROVIDER=vapi, or for agencies that use the platform's Vapi account):
# the private key (server) and the public key (browser test call), from the Vapi dashboard's API Keys page.
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
# Optional. Signs Vapi's call reports; falls back to MAILBOX_KEY.
VAPI_WEBHOOK_SECRET=
# Optional. The model Vapi receptionists use (default openai gpt-4o-mini).
VAPI_MODEL_PROVIDER=
VAPI_MODEL=
MAILBOX_KEY=                 # openssl rand -base64 32 ; never change it once mailboxes are connected

# --- Cloud ---
PUBLIC_URL=                  # e.g. https://dashboard.example.com (leave empty locally; `bun run tunnel` fills in)
HOST=127.0.0.1               # 0.0.0.0 in a container
API_PORT=8791
DATABASE_CA_FILE=            # optional CA bundle for sslmode=verify-full (e.g. the RDS bundle)
DATABASE_POOL=10

# --- Accounts ---
ALLOW_SIGNUP=false           # true lets anyone create a team; otherwise invite-only after the first account
SMTP_URL=                    # for invite/reset emails, e.g. smtps://USER:PASS@email-smtp.ap-southeast-2.amazonaws.com:465
MAIL_FROM=                   # e.g. Twin Receptionist <no-reply@example.com>

# --- Sign in with Google / Microsoft, for mailboxes and calendars (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=         # defaults to PUBLIC_URL

# --- "Ask for help" AI assistant for agency owners and admins (optional) ---
OPENROUTER_API_KEY=          # unset = no button. From openrouter.ai/keys
OPENROUTER_MODEL=            # default anthropic/claude-sonnet-5.5
