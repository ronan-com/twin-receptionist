# https certificates come from Let's Encrypt automatically, for every host in SITE_HOSTS.
{$SITE_HOSTS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:8791
}
