# Copy to deploy/.env and fill in. Never commit the real file.
SITE_HOST=setup.yourcompany.com
SITE_URL=https://setup.yourcompany.com
SELLER_NAME=Twin Technologies
PRODUCT_NAME=AI Receptionist
SUPPORT_EMAIL=support@yourcompany.com
# Encrypts buyers' keys while they set up. 32 random bytes, base64: bun admin.ts gen-key
# Keep a copy somewhere safe; if it's lost, half-finished setups must re-enter their keys.
SETUP_SECRET_KEY=
# /admin: who may sign in, and the password hash from `bun admin.ts admin-hash` (write each $ as $$).
ADMIN_EMAILS=
ADMIN_PASSWORD_HASH=
# Optional: the "Need help?" chat on the wizard and /guide. Without the key the bubble is hidden.
# Model default: anthropic/claude-sonnet-5.5
OPENROUTER_API_KEY=
SETUP_CHAT_MODEL=
# Optional: our own mail sender, so /admin can send the welcome email.
SITE_SMTP_URL=
SITE_MAIL_FROM=
