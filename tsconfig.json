{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "bun"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "scripts/e2e/mkclient.ts", "vite.config.ts"],
  "exclude": ["src/legacy"]
}
