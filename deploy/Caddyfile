# Global options. on_demand_tls is for the setup site's buyers' own domains (sites/setupsite.caddy): Caddy asks the setup
# site whether a name is one of theirs before it gets a certificate. Only names it answers 200 for are served.
{
	on_demand_tls {
		ask http://setup-site:4500/api/tls-allowed
	}
}

# https certificates come from Let's Encrypt automatically, for every host in SITE_HOSTS.
{$SITE_HOSTS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:8791
}

# Extra sites (e.g. the isolated Answered build) drop their own file in /opt/twin/sites.
import /etc/caddy/sites/*.caddy
